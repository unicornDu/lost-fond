{
  "name": "shiguang-desktop",
  "version": "1.1.2",
  "description": "拾光 · 校园失物招领平台 Windows 独立版（Electron + 内置 Spring Boot/H2）",
  "main": "main.js",
  "author": "Shiguang",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "node build-dist.mjs"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shiguang.lostfound",
    "productName": "拾光",
    "executableName": "shiguang",
    "copyright": "拾光 · 校园失物招领平台",
    "directories": {
      "output": "../build/release-1.1.2",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload/**",
      "login/**",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/target/lost-found-backend.jar",
        "to": "backend/lost-found-backend.jar"
      },
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      },
      {
        "from": "../backend/uploads/seed",
        "to": "seed"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Shiguang-Windows-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "拾光",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  }
}
